<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white_black"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_dot"
                android:backgroundTint="@color/app_color_soft" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/baseline_location_on_24"
                app:tint="@color/app_color" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Joylashuv olinmadi!"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/black_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="8dp"
            android:text="Joylashuvni qayta olish uchun tasdiqlang"
            android:textAppearance="@style/TextAppearance.App.BodyMedium"
            android:textColor="@color/gray_full" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="@dimen/radius_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/space_14"
                android:text="@string/submit"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textColor="@color/white" />

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>