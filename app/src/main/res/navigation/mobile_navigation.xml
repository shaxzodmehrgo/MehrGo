    <!-- Transparent placeholder ONLY. The real MapFragment is mounted persistently in MainActivity's
         flPersistentMap (Activity-hosted) so its Yandex GL surface never rebuilds on navigation. The id
         + all actions below are unchanged, so every action / popUpTo=@id/mapFragment /
         popBackStack(R.id.mapFragment) / getAction(action_mapFragment_*) keeps resolving. -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="uz.teamwork.mehrgodriver.presentation.maps.yandex_map.MapPlaceholderFragment"
        android:label="fragment_map">
        <action
            android:id="@+id/action_mapFragment_to_ordersMapFragment"
            app:destination="@id/ordersMapFragment" />
        <action
            android:id="@+id/action_mapFragment_self"
            app:destination="@id/mapFragment"
            app:popUpTo="@id/mapFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_mapFragment_to_mapSettingsFragment"
            app:destination="@id/mapSettingsFragment" />
        <action
            android:id="@+id/action_mapFragment_to_notificationsMapFragment"
            app:destination="@id/notificationsMapFragment" />
        <action
            android:id="@+id/action_mapFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/mapFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_mapFragment_to_accessPermissionsFragment"
            app:destination="@id/accessPermissionsFragment" />
        <action
            android:id="@+id/action_mapFragment_to_tripFinishFragment"
            app:destination="@id/tripFinishFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripFinishFragment"
        android:name="uz.teamwork.mehrgodriver.presentation.maps.yandex_map.trip_finish.TripFinishFragment"
