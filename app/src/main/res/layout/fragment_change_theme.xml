<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light_black_light"
    tools:context=".presentation.main.ui.change_theme.ChangeThemeFragment">

    <LinearLayout
        android:id="@+id/clToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        app:layout_constraintBaseline_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_8"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/settings_theme"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/black_white" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_24">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                app:cardBackgroundColor="@color/white_black"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/background_settings_icon_chip"
                        android:padding="@dimen/space_8"
                        android:src="@drawable/ic_theme_auto"
                        app:tint="@color/app_color" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/settings_theme"
                        android:textAppearance="@style/TextAppearance.App.Headline"
                        android:textColor="@color/black_white" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/llDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardBackgroundColor="@color/amber_soft"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_theme_day"
                        app:tint="@color/app_color" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvDay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/theme_day"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivDayCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardBackgroundColor="@color/blue_soft"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_theme_night"
                        app:tint="@color/blue_middle" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvNight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/theme_night"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivNightCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardBackgroundColor="@color/green_soft"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_theme_auto"
                        app:tint="@color/green" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvSystem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/theme_system"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivSystemCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
