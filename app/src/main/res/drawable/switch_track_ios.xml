<?xml version="1.0" encoding="utf-8"?><!--
  iOS-style switch track: 44x26 pill, amber (accent) when ON, neutral gray when OFF.
  Pair with switch_thumb_ios on a SwitchCompat (app:track / android:thumb).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_color" />
            <corners android:radius="13dp" />
            <size android:width="44dp" android:height="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_middle_black_middle" />
            <corners android:radius="13dp" />
            <size android:width="44dp" android:height="26dp" />
        </shape>
    </item>
</selector>
