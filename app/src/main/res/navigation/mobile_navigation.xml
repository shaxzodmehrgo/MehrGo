<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">


    <action
        android:id="@+id/action_global_to_verificationFragment"
        app:destination="@id/verificationFragment"
        app:launchSingleTop="true" />

    <fragment
        android:id="@+id/navigation_home"
        android:name="uz.teamwork.mehrgodriver.presentation.main.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_navigation_home_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_languageFragment"
            app:destination="@id/languageFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_introduceFragment"
            app:destination="@id/introduceFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_completeDriverInfoFragment"
            app:destination="@id/completeDriverInfoFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_myPaymentFragment"
            app:destination="@id/myPaymentFragment" />
        <action
            android:id="@+id/action_navigation_home_to_instructionFragment"
            app:destination="@id/instructionFragment" />
        <action
            android:id="@+id/action_navigation_home_to_notActiveUserFragment"
            app:destination="@id/notActiveUserFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_mapFragment"
            app:destination="@id/mapFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_accessPermissionsFragment"
            app:destination="@id/accessPermissionsFragment" />
        <action
            android:id="@+id/action_navigation_home_to_maktabGoLoginFragment"
            app:destination="@id/maktabGoLoginFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_maktabGoRoutesFragment"
            app:destination="@id/maktabGoRoutesFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_navigation_home_to_maktabGoMapFragment"
            app:destination="@id/maktabGoMapFragment"
            app:popUpTo="@id/navigation_home"
            app:popUpToInclusive="true" />
    </fragment>


