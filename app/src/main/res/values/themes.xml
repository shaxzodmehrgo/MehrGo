<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TeamworkTaxi" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/app_color</item>
        <item name="colorPrimaryVariant">@color/app_color</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/app_color</item>
        <item name="colorSecondaryVariant">@color/app_color</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Untinted indeterminate ProgressBars (and other activated controls) follow the brand
             accent instead of the Material default teal-green. -->
        <item name="colorControlActivated">@color/app_color</item>

        <!-- Transparent status + navigation bars: app content draws behind both,
             edge-to-edge. These bar-color attributes only take effect below Android 15 —
             on 15+ edge-to-edge is enforced (bars always transparent, attributes ignored)
             and the in-window backing views (navView padding / vNavBarBg strip in
             MainActivity, the splash strips in FirstActivity) paint the bar areas. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Nav bar is a SOLID surface app-wide (boss: always visible): white in light, dark in
             dark, with a thin top divider so it reads as its own bar everywhere. -->
        <item name="android:navigationBarColor">@color/white_black</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="p">
            @color/gray_middle_black_middle
        </item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Neutral surface window background so heavy recreates (locale change) and screen
             transitions never flash the platform's near-black default; day/night aware. -->
        <item name="android:windowBackground">@color/white_black</item>

        <!-- Autofill highlight: rounded to match the field shape instead of a hard rectangle. -->
        <item name="android:autofilledHighlight" tools:targetApi="o">@drawable/autofill_highlight
        </item>

        <!-- Customize your theme here. -->
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
        <!-- Plain Dialog() windows opt out of Android 15 forced edge-to-edge so their
             content insets from the status/navigation bars (otherwise bottom-anchored
             dialog content draws under the nav bar). BottomSheetDialogs still need
             per-sheet inset padding — see Dialog.fitSystemBars(). -->
        <item name="android:dialogTheme">@style/AppDialogTheme</item>
    </style>

    <!-- Splash (FirstActivity): force a WHITE status bar and a brand-GREEN navigation
         bar with dark icons, in BOTH light and dark mode. Hard-coded colors (not the
         day/night white_black / gray_light_black_light) so the bars never turn black in
         dark mode. These attributes cover Android 14 and lower; on 15+ (enforced
         edge-to-edge, attributes ignored) FirstActivity paints the same bands with the
         inset-sized vSplashStatusBarBg / vSplashNavBarBg strips. -->
    <style name="Theme.TeamworkTaxi.Splash" parent="Theme.TeamworkTaxi">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/brand_teal</item>
        <!-- No nav-bar divider on the splash — it keeps its clean brand-teal bar (the app-wide
             divider is only for the in-app surfaces). -->
        <item name="android:navigationBarDividerColor" tools:targetApi="p">
            @android:color/transparent
        </item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Full-screen, non-floating dialog for the expanded trip route map. The fragment drives
         immersive edge-to-edge at runtime the same way the main view does: hides the bars, draws
         the map into the cutout strip, and insets the controls off the status/gesture areas. -->
    <style name="FullScreenMapDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/white_black</item>
        <!-- Transparent bars for Android 14 and lower; 15+ enforces them transparent anyway. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Bottom sheets run under Android 15 edge-to-edge enforcement: the nav-bar strip is
         painted by the sheet's own opaque background, extended under the transparent bar by
         the inset padding in Dialog.fitSystemBars()/applyContentInsets (DialogInsets.kt).
         On 14 and lower Dialog.hideSystemBars() keeps the legacy opaque colored nav bar. -->
    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
    </style>

    <style name="BottomSheetModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/background_dialog_bsh</item>
    </style>

    <!-- Theme for plain Dialog() windows. All of the app's plain dialogs are centered,
         floating, wrap-content windows, which the framework keeps inset from the system
         bars on every version — no edge-to-edge opt-out needed. Kept as the app-wide
         android:dialogTheme hook in case dialog-window tweaks are needed later. -->
    <style name="AppDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog" />

    <!-- Rounded, gray-filled field matching the Registration fields (same
         gray_middle_black_middle surface), with an amber border only on focus. -->
    <style name="ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/gray_middle_black_middle</item>
        <item name="boxStrokeColor">@color/app_color</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="colorOnPrimary">@color/app_color</item>
        <item name="colorAccent">@color/black</item>
        <item name="strokeColor">@color/black</item>
        <item name="colorPrimary">@color/black</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/gray_middle_black_middle</item>
        <item name="boxStrokeColor">@color/app_color</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="colorOnPrimary">@color/app_color</item>
        <item name="colorAccent">@color/black</item>
    </style>

    <style name="CustomTabLayoutStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.025</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Branded Material date picker: amber header, surface body that follows day/night,
         amber selected day, and amber OK/Cancel buttons. One DayNight definition (the color
         tokens resolve per mode) covers both light and dark. -->
    <style name="AppMaterialDatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/app_color</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/white_black</item>
        <item name="colorOnSurface">@color/black_white</item>
        <item name="android:colorBackground">@color/white_black</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppMaterialDatePicker.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppMaterialDatePicker.Button</item>
    </style>

    <style name="AppMaterialDatePicker.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/app_color</item>
    </style>

    <!--    <style name="SwipeButtonTheme">-->
    <!--        <item name="color">@color/green</item>-->
    <!--    </style>-->
</resources>