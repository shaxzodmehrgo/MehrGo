<?xml version="1.0" encoding="utf-8"?><!-- Add-card screen (navigated, mirrors the client app's AddCardFragment): labeled fields
     with an icon inside a soft rounded input, submit pinned at the bottom. Step 2 (OTP)
     is a separate destination — AddCardConfirmFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light_black_light"
    android:orientation="vertical"
    tools:context=".presentation.main.ui.add_card.AddCardFragment">

    <LinearLayout
        android:id="@+id/clToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_8"
                android:contentDescription="@null"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/add_card"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/black_white" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/card_number_hint"
                android:textColor="@color/gray_full"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_14">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ph_credit_card"
                    app:tint="@color/app_color" />

                <com.santalu.maskara.widget.MaskEditText
                    android:id="@+id/etCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="8600 0000 0000 0000"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_14"
                    android:textColor="@color/black_white"
                    android:textColorHint="@color/gray_full"
                    android:textSize="16sp"
                    app:mask="____ ____ ____ ____"
                    app:maskCharacter="_"
                    app:maskStyle="normal"
                    tools:ignore="HardcodedText,LabelFor" />

            </LinearLayout>

            <!-- Expiry date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:fontFamily="sans-serif-medium"
                android:text="@string/card_expiry_hint"
                android:textColor="@color/gray_full"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_14">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ph_clock"
                    app:tint="@color/app_color" />

                <com.santalu.maskara.widget.MaskEditText
                    android:id="@+id/etExpiredDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="12/27"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_14"
                    android:textColor="@color/black_white"
                    android:textColorHint="@color/gray_full"
                    android:textSize="16sp"
                    app:mask="__/__"
                    app:maskCharacter="_"
                    app:maskStyle="normal"
                    tools:ignore="HardcodedText,LabelFor" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16">

        <TextView
            android:id="@+id/tvSubmit"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/to_continue" />

        <ProgressBar
            android:id="@+id/pbSubmit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white_black"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
