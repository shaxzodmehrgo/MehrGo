<?xml version="1.0" encoding="utf-8"?><!-- Service icon disc: soft brand wash + a hairline brand outline.
     Same reasoning as bg_chip_service.xml — the soft wash ALONE has no edge. Measured:
     app_color_soft is 12% amber (#1FF59E0B), which composites to #FEF3E1 on a white card,
     a contrast ratio of 1.10:1. That is invisible in daylight, so the disc could not explain
     the 10dp of space it puts between the card's content line and the glyph inside it, and
     the row read as text randomly indented. The 1dp app_color edge gives the disc a real
     boundary that lands ON the content line.

     Deliberately NOT folded into bg_icon_chip_round: that drawable is used by five other
     layouts which set android:backgroundTint per use, and a tint (SRC_IN) would repaint the
     stroke the same colour as the fill and erase it. So this one carries its own colours and
     must be used WITHOUT backgroundTint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/app_color_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/app_color" />
</shape>
