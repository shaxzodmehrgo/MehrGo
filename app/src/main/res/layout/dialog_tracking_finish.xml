<?xml version="1.0" encoding="utf-8"?><!--
  Finish-confirmation dialog (driver taps "Yakunlash" on the trip sheet).
  Reads top→bottom as: success header → hero total + payment chip →
  itemised fare breakdown → Continue / Finish CTAs. Hero-first so the
  amount the driver is about to settle is the first thing the eye lands on.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white_black"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="8dp"
    app:strokeColor="@color/gray_middle_black_middle"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <!-- Success header -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/shape_dot"
                android:backgroundTint="@color/green_soft">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_check_circle_24"
                    app:tint="@color/green" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/finish_confirm_title"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/black_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/finish_confirm_subtitle"
                android:textColor="@color/gray_full"
                android:textSize="13sp" />

            <!-- Hero total -->
            <TextView
                android:id="@+id/tvFinalTotalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="0 So'm"
                android:textColor="@color/app_color"
                android:textSize="40sp" />

            <!-- Payment-method chip — recoloured in code: green (cash) / blue (card) -->
            <LinearLayout
                android:id="@+id/llPaymentType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_gray"
                android:backgroundTint="@color/green_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/ivPaymentType"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ph_money"
                    app:tint="@color/green" />

                <TextView
                    android:id="@+id/tvPaymentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/green"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Fare breakdown -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/gray_light_black_light"
                app:strokeColor="@color/gray_middle_black_middle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Distance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="13dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/distance"
                            android:textColor="@color/gray_full"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:text="0 km"
                            android:textColor="@color/black_white"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_middle_black_middle" />

                    <!-- Waiting price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="13dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/price_waiting"
                            android:textColor="@color/gray_full"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvWaitTimePrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:text="0 So'm"
                            android:textColor="@color/black_white"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_middle_black_middle" />

                    <!-- Additional services -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="13dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/additional_price"
                            android:textColor="@color/gray_full"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvAddServicesPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:text="0 So'm"
                            android:textColor="@color/black_white"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_middle_black_middle" />

                    <!-- Ride price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="13dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/price_track"
                            android:textColor="@color/gray_full"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTrackPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:text="0 So'm"
                            android:textColor="@color/black_white"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- Subtotal (gross before discounts) — shown only with promo/bonus -->
                    <LinearLayout
                        android:id="@+id/llTotalPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_middle_black_middle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="13dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/total_price"
                                android:textColor="@color/black_white"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvTotalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end"
                                android:maxLines="1"
                                android:paddingStart="12dp"
                                android:text="0 So'm"
                                android:textColor="@color/black_white"
                                android:textSize="15sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Bonus (deduction) -->
                    <LinearLayout
                        android:id="@+id/llBonus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_middle_black_middle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="13dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/bonus"
                                android:textColor="@color/gray_full"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvBonusPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end"
                                android:maxLines="1"
                                android:paddingStart="12dp"
                                android:text="0 So'm"
                                android:textColor="@color/red"
                                android:textSize="15sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Promo code (deduction) -->
                    <LinearLayout
                        android:id="@+id/llPromoCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_middle_black_middle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="13dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/promo_code"
                                android:textColor="@color/gray_full"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvPromoCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end"
                                android:maxLines="1"
                                android:paddingStart="12dp"
                                android:text="0 So'm"
                                android:textColor="@color/red"
                                android:textSize="15sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CTAs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcvCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="15dp"
                        android:text="@string/to_continue"
                        android:textColor="@color/black_white"
                        android:textSize="16sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcvSubmit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_submit_state">

                        <TextView
                            android:id="@+id/tvSubmit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="15dp"
                            android:text="@string/to_finish"
                            android:textColor="@color/text_submit_state"
                            android:textSize="16sp" />

                        <ProgressBar
                            android:id="@+id/pbSubmit"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/text_submit_state"
                            android:visibility="gone" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>
