<?xml version="1.0" encoding="utf-8"?><!-- Single dropdown row used by the ExposedDropdownMenu adapters. Comfortable touch
     target, themed text, and a ripple on press instead of the default flat gray bar. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:minHeight="52dp"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12"
    android:textColor="@color/black_white"
    android:textSize="16sp" />
