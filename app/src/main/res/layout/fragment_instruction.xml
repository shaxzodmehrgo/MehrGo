<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_black"
    tools:context=".presentation.main.ui.instuction.InstructionFragment">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_8">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_margin="@dimen/space_8"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingEnd="@dimen/space_16"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/black_white" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/gray_middle_black_middle" />

        <!-- Poster + play: in-app playback is impossible — YouTube blocks WebView embeds with
             an instant UNKNOWN error on every video, and the m.youtube.com watch page would not
             play either. Tapping hands off to the YouTube app (YoutubeHelper.openExternally). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_24">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvPoster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/gray_light_black_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="190dp">

                    <ImageView
                        android:id="@+id/ivPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_photo_scrim" />

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_permission_icon">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ph_play_circle"
                            app:tint="@color/app_color" />

                    </FrameLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/btnWatchOnYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:drawablePadding="@dimen/space_8"
                android:drawableTint="@color/app_color"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/ripple_intro_skip"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_24"
                android:paddingVertical="@dimen/space_12"
                android:text="@string/open_in_youtube_app"
                android:textColor="@color/app_color"
                android:textSize="15sp"
                app:drawableStartCompat="@drawable/ph_play_circle" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/app_color"
        android:visibility="gone" />

</FrameLayout>
