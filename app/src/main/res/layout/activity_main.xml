<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Persistent map host: MapFragment is mounted here ONCE (Activity-hosted, NAVIGATOR mode)
         so its Yandex MapView GL surface follows the Activity lifecycle and is never torn down
         when the driver navigates to another in-app screen (History/Settings/…). Placed FIRST in
         the root container so it draws BEHIND `content` (the NavHost); the map placeholder
         destination is transparent, so the map shows through. Lives in `container` (not `content`)
         to avoid the pushed-screen bottom-inset padding squeezing the map. Hidden until mounted. -->
    <FrameLayout
        android:id="@+id/flPersistentMap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--        <com.google.android.material.bottomnavigation.BottomNavigationView-->
        <!--            android:id="@+id/nav_view"-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_marginStart="0dp"-->
        <!--            android:layout_marginEnd="0dp"-->
        <!--            app:itemIconSize="20dp"-->
        <!--            app:labelVisibilityMode="labeled"-->
        <!--            android:background="?android:attr/windowBackground"-->
        <!--            app:layout_constraintBottom_toBottomOf="parent"-->
        <!--            app:layout_constraintLeft_toLeftOf="parent"-->
        <!--            app:layout_constraintRight_toRightOf="parent"-->
        <!--            app:menu="@menu/bottom_nav_menu" />-->

        <View
            android:id="@+id/vNavDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/gray_middle_black_middle"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/nav_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:background="@color/gray_light_black_light"
            android:visibility="gone"
            app:elevation="0dp"
            app:itemIconSize="20dp"
            app:itemIconTint="@drawable/selector_bottom_nav_item_icon"
            app:itemTextColor="@drawable/selector_bottom_nav_item_text"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:menu="@menu/bottom_nav_menu" />

        <fragment
            android:id="@+id/nav_host_fragment_activity_main"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/nav_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/mobile_navigation" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- "Our style" system-navigation-bar backing for tab-less screens (auth/install + pushed
         details): a solid themed strip the height of the gesture/nav bar with a thin top divider.
         Declared AFTER `content` so it draws ON TOP of the NavHost: the persistent-map pivot gave
         the NavHost an opaque background (bleed-through mask), and a view's background also fills
         its bottom-inset padding — which hid this strip + divider when they sat behind. Content on
         these screens is padded above the nav bar, so nothing meaningful is covered. Toggled by
         the destination listener; height = nav inset. -->
    <View
        android:id="@+id/vNavBarBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white_black"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <View
        android:id="@+id/vNavBarBgDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/gray_middle_black_middle"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/vNavBarBg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>