<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.main.ui.orders_history.OrderHistoryDetailFragment">

    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_8"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/order_details"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/black_white" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gray_light_black_light"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_24">

            <!-- Hero: status + date + total -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_balance_gradient"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="#33FFFFFF"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="@dimen/space_10"
                            android:paddingVertical="5dp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            tools:text="Yakunlangan" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="#33FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/space_10"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:src="@drawable/baseline_calendar_month_24"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_4"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:text="Jun 14, 2026 15:34" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Label swaps to "Naqd olinadi" / "To'lovga" once the settlement block
                         (myOrder.payment) is on the row, because the hero figure then is the
                         collected amount, not the order total. -->
                    <TextView
                        android:id="@+id/tvTotalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:alpha="0.85"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/total_earned"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:baselineAligned="true"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            tools:text="10 000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_6"
                            android:layout_marginBottom="3dp"
                            android:alpha="0.85"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/sum"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Route -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/icon_map"
                            app:tint="@color/app_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/route"
                            android:textColor="@color/black_white"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/shape_dot"
                            android:backgroundTint="@color/green" />

                        <TextView
                            android:id="@+id/tvFrom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_10"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/black_white"
                            tools:text="Beshkurgan, Tashkent" />

                    </LinearLayout>

                    <!-- Intermediate stops (positions 1..n-1) — populated by RoutePointsBinder so
                         multi-point trips show EVERY point, not just pickup → dropoff. -->
                    <LinearLayout
                        android:id="@+id/llMiddlePoints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_12">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/shape_dot"
                            android:backgroundTint="@color/red" />

                        <TextView
                            android:id="@+id/tvTo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_10"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/black_white"
                            tools:text="Madaniyat 26, Tashkent" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Stats: tariff / distance / time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardBackgroundColor="@color/amber_soft"
                            app:cardCornerRadius="@dimen/radius_sm"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/baseline_directions_car_24"
                                app:tint="@color/app_color" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvTariff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/black_white"
                            android:textSize="14sp"
                            tools:text="Standart" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/tariff"
                            android:textColor="@color/gray_full"
                            android:textSize="10sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardBackgroundColor="@color/blue_soft"
                            app:cardCornerRadius="@dimen/radius_sm"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/baseline_straighten_24"
                                app:tint="@color/blue_middle" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/black_white"
                            android:textSize="14sp"
                            tools:text="21.8 km" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/driver_earnings_distance"
                            android:textColor="@color/gray_full"
                            android:textSize="10sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardBackgroundColor="@color/green_soft"
                            app:cardCornerRadius="@dimen/radius_sm"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/baseline_access_time_24"
                                app:tint="@color/green" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/black_white"
                            android:textSize="14sp"
                            tools:text="—" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/total_time"
                            android:textColor="@color/gray_full"
                            android:textSize="10sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Activated services — the add-ons the client had on for this trip. Their total is
                 already baked into the hero price, so this card is a breakdown of what the driver
                 was paid for, not an extra to add on. Hidden when the order had none.
                 No horizontal padding on the column: see the SECTION-CARD RULE in
                 dialog_bsh_order_state.xml — the rule below has to reach the card border. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvServices"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_14">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_16">

                        <!-- Same disc as the rows below (36/20, outlined) — a 28dp untinted-looking
                             bead directly above 36dp discs read as a different component. -->
                        <FrameLayout
                            android:layout_width="@dimen/icon_chip_size"
                            android:layout_height="@dimen/icon_chip_size"
                            android:background="@drawable/bg_service_icon_chip">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ph_seal_check"
                                app:tint="@color/app_color" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:letterSpacing="0.06"
                                android:maxLines="1"
                                android:text="@string/activated_services"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextAppearance.App.Micro" />

                            <TextView
                                android:id="@+id/tvServicesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                tools:text="1 ta xizmat faol" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llServicesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_16" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_middle_black_middle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_16">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_services"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvServicesTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Price"
                            tools:text="5 000 so'm" />
                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Fare breakdown — how the gross order price became the amount actually collected
                 (myOrder.payment). Shown ONLY when there is something to explain: a promo, a
                 spent bonus, or a card-settled part. With none of those the hero already IS the
                 whole story and a card repeating it twice is noise. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvFare"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_12"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/fare_breakdown"
                        android:textColor="@color/black_white"
                        android:textSize="13sp" />

                    <!-- Gross: the order total, i.e. what myOrder.price carries. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_price"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFareGross"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/black_white"
                            android:textSize="13sp"
                            tools:text="33 000 so'm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFarePromo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvFarePromoLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/promo_code"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp"
                            tools:text="Promo kod · Yashiluyim" />

                        <TextView
                            android:id="@+id/tvFarePromo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/red"
                            android:textSize="13sp"
                            tools:text="-6 600 so'm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFareBonus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bonus"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFareBonus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/red"
                            android:textSize="13sp"
                            tools:text="-7 270 so'm" />

                    </LinearLayout>

                    <!-- Cash settles to the nearest 1 000 so'm. The difference gets its own line
                         so gross − promo − bonus ± rounding still foots to the bold total below
                         instead of silently not adding up. GONE on a card trip (exact charge). -->
                    <LinearLayout
                        android:id="@+id/llFareRounding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rounding"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFareRounding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp"
                            tools:text="-130 so'm" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_10"
                        android:background="@color/gray_middle_black_middle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFareTotalLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/amount_cash_to_collect"
                            android:textColor="@color/black_white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFareTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/app_color"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="19 130 so'm" />

                    </LinearLayout>

                    <!-- Card-settled part, and whatever is still left to take in cash. Only a
                         mixed/card trip shows these. -->
                    <LinearLayout
                        android:id="@+id/llFareCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/paid_by_card"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFareCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/black_white"
                            android:textSize="13sp"
                            tools:text="19 130 so'm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFareCash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/amount_cash_to_collect"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFareCash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/black_white"
                            android:textSize="13sp"
                            tools:text="0 so'm" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Trip details: waited time -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDetails"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_12"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/trip_details"
                        android:textColor="@color/black_white"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/baseline_access_time_24"
                            app:tint="@color/app_color" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_10"
                            android:layout_weight="1"
                            android:text="@string/waited_time"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvWaited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/black_white"
                            android:textSize="13sp"
                            tools:text="00:00:03" />

                    </LinearLayout>

                    <!-- Payment method (cash/card), read off myOrder.payment (method + card_paid).
                         Still HIDDEN when the row carries no settlement block at all — on this
                         wire "absent" means unknown, not cash, and asserting cash on a card trip
                         would corrupt the driver's end-of-day reconciliation. -->
                    <LinearLayout
                        android:id="@+id/llPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_12"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ph_money"
                            app:tint="@color/app_color" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_10"
                            android:layout_weight="1"
                            android:text="@string/payment_method"
                            android:textColor="@color/gray_full"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvPayment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/black_white"
                            android:textSize="13sp"
                            tools:text="Naqd pul" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Dispatcher — the client's name/phone is intentionally NOT shown on a
                 completed order (privacy). For any post-trip question the driver contacts
                 the branch dispatcher. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDispatcher"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_12"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dispatcher"
                        android:textColor="@color/black_white"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/app_color_soft"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ph_headset"
                                app:tint="@color/app_color" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="@string/dispatcher_help_hint"
                                android:textColor="@color/black_white"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvDispatcherPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:textColor="@color/gray_full"
                                android:textSize="12sp"
                                tools:text="+998 71 200 00 00" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/llCallDispatcher"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/app_color_soft"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_call"
                                app:tint="@color/app_color" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Order id -->
            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:textColor="@color/gray_full"
                android:textSize="11sp"
                tools:text="# 49 235" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
