<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light_black_light"
    tools:context=".presentation.main.ui.change_language.ChangeLanguageFragment">

    <LinearLayout
        android:id="@+id/clToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        app:layout_constraintBaseline_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_8"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/change_language"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/black_white" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_24">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                app:cardBackgroundColor="@color/white_black"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/background_settings_icon_chip"
                        android:padding="@dimen/space_8"
                        android:src="@drawable/baseline_language_24"
                        app:tint="@color/app_color" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/change_language"
                        android:textAppearance="@style/TextAppearance.App.Headline"
                        android:textColor="@color/black_white" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/llUzbek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/background_settings_icon_chip"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/flag_uz" />

                <TextView
                    android:id="@+id/tvUzbek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="O'zbekcha"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivUzbekCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llKazakh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/background_settings_icon_chip"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/flag_kk" />

                <TextView
                    android:id="@+id/tvKazakh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="Қазақша"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivKazakhCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llKyrgyz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/background_settings_icon_chip"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/flag_ky" />

                <TextView
                    android:id="@+id/tvKyrgyz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="Кыргызча"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivKyrgyzCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llRussian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/background_stroke_gray"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/background_settings_icon_chip"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/flag_ru" />

                <TextView
                    android:id="@+id/tvRussian"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="Русский"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/black_white" />

                <ImageView
                    android:id="@+id/ivRussianCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_radio_button_unchecked_24"
                    app:tint="@color/gray" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/app_color"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingVertical="@dimen/space_16"
                        android:text="@string/submit"
                        android:textColor="@color/text_submit_state"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Shown in place of the label while the change-language request runs. -->
                    <ProgressBar
                        android:id="@+id/pbSubmit"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/text_submit_state"
                        android:visibility="gone" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
