<?xml version="1.0" encoding="utf-8"?><!-- Hairline pill outline drawn as the swipe button's foreground so its white track is
     visible against the white pinned bar. Transparent interior keeps the slider + text visible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="@color/app_color" />
    <corners android:radius="100dp" />
</shape>
