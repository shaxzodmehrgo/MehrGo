<?xml version="1.0" encoding="utf-8"?><!-- Outlined input field (e.g. top-up amount): subtle fill + visible border so it
     clearly reads as an editable field on a white sheet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/gray_light_black_light" />
    <corners android:radius="@dimen/radius_md" />
    <stroke
        android:width="1.5dp"
        android:color="@color/gray_middle_black_middle" />
</shape>
