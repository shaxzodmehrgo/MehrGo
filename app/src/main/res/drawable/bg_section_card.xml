<?xml version="1.0" encoding="utf-8"?><!--
  iOS-style section card: a rounded surface that floats on the canvas background. Used to
  group the order-detail sections (fare, metrics, route, details) so the panel reads as
  distinct cards instead of one long divided page. Subtle 1dp hairline for definition,
  matching the mini-map card's stroke. Day/night aware.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white_black" />
    <corners android:radius="@dimen/radius_lg" />
    <stroke
        android:width="1dp"
        android:color="@color/gray_middle_black_middle" />
</shape>
