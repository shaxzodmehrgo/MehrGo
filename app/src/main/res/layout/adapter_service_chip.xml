<?xml version="1.0" encoding="utf-8"?><!-- One activated service: leading glyph + "Name · price".
     A TextView with a compound drawable rather than an ImageView+TextView row, so a
     ChipGroup can flow and wrap it exactly like the plain adapter_chip it replaces. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chip_service"
    android:drawablePadding="6dp"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:gravity="center_vertical"
    android:maxWidth="240dp"
    android:maxLines="1"
    android:paddingHorizontal="@dimen/space_12"
    android:paddingVertical="@dimen/space_6"
    android:textColor="@color/app_color"
    android:textSize="13sp"
    app:drawableTint="@color/app_color"
    tools:text="Konditsioner · 2 000" />
