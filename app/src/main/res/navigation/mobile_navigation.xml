            app:popUpTo="@id/maktabGoLoginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_maktabGoLoginFragment_to_maktabGoMapFragment"
            app:destination="@id/maktabGoMapFragment"
            app:popUpTo="@id/maktabGoLoginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/maktabGoRoutesFragment"
        android:name="uz.teamwork.mehrgodriver.presentation.main.ui.maktabgo_routes.MaktabGoRoutesFragment"
