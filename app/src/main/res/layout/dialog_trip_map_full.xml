<?xml version="1.0" encoding="utf-8"?><!--
  Expanded full-screen route map (iOS TripView fullScreenCover): A→B route + markers, speed
  badge (top-start), close ✕ (top-end), a recenter/heading/zoom± control column (center-end),
  and the "Open in navigator" bar (disabled until the trip starts). Closing returns to the detail.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_black">

    <com.yandex.mapkit.mapview.MapView
        android:id="@+id/mapTripFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Speed badge (top-start) -->
    <LinearLayout
        android:id="@+id/llFullSpeed"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_full_speed"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFullSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="0"
            android:textColor="@color/black_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km/h"
            android:textColor="@color/gray_full"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Close (top-end) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvCloseTripMap"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white_black"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/gray_middle_black_middle"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ph_x"
            app:tint="@color/black_white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Right control column (center-end): recenter · heading · zoom+ · zoom- -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvRecenter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white_black"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gray_middle_black_middle"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ph_crosshair"
                app:tint="@color/black_white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvFitRoute"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white_black"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gray_middle_black_middle"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:scaleX="-1"
                android:src="@drawable/ph_navigation_arrow"
                app:tint="@color/black_white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvZoomIn"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white_black"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gray_middle_black_middle"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ph_plus"
                app:tint="@color/black_white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvZoomOut"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white_black"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gray_middle_black_middle"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ph_minus"
                app:tint="@color/black_white" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Open in navigator (bottom) — disabled until the trip starts. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvFullNavigate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/app_color"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp"
        app:rippleColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_open_map"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvFullNavigate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/open_in_navigator"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
