            <!-- Connection status badge. Connecting/reconnecting → live spinner;
                 off-shift → static error icon. -->
            <LinearLayout
                android:id="@+id/llConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="92dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/white_black"
                android:elevation="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_10">

                <ProgressBar
                    android:id="@+id/pbBadgeSpinner"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:indeterminateTint="@color/gray_full"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivBadgeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_error_circle"
                    android:visibility="gone"
                    app:tint="@color/gray_full" />

                <TextView
                    android:id="@+id/tvNoConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/you_do_not_at_work"
                    android:textColor="@color/gray_full"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llBottomArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="26dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <!-- Active-trip resume mini-card (shown while the trip page is minimised) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvResumeTrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_button"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white_black"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/green"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/shape_dot"
                            android:backgroundTint="@color/green_soft">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ph_car"
                                app:tint="@color/green" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvResumeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/active_trip"
                                android:textAppearance="@style/TextAppearance.App.Micro"
                                android:textColor="@color/green" />

                            <TextView
                                android:id="@+id/tvResumeAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/not_showed"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                android:textColor="@color/black_white" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_green"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:text="@string/to_continue"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableEndCompat="@drawable/ph_caret_right"
                            app:drawableTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Verification required card (offline + a mandatory check failing) — sits
                     above the slide-to-start, styled like the active-trip card but bigger. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvVerificationCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_button"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white_black"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/red"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <FrameLayout
                            android:id="@+id/flVerifDot"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/shape_dot"
                            android:backgroundTint="@color/red_soft">

                            <ImageView
                                android:id="@+id/ivVerifIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ph_warning"
                                app:tint="@color/red" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvVerifStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/verification_status_required"
                                android:textAppearance="@style/TextAppearance.App.Micro"
                                android:textColor="@color/red" />

                            <TextView
                                android:id="@+id/tvVerifTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/verification_chip_required"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                android:textColor="@color/black_white" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivVerifCaret"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ph_caret_right"
                            app:tint="@color/red" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <FrameLayout
                    android:id="@+id/flBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/llFinishJobAndCall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvFinishJob"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_6"
                            android:layout_weight="1"
                            android:backgroundTint="@color/red"
                            app:cardCornerRadius="@dimen/radius_lg"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:drawablePadding="@dimen/space_8"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingHorizontal="@dimen/space_8"
                                android:paddingVertical="16dp"
                                android:text="@string/exit"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                app:drawableStartCompat="@drawable/baseline_power_settings_new_24"
                                app:drawableTint="@color/white" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvDispatcher"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_6"
                            android:layout_weight="1"
                            android:backgroundTint="@color/app_color"
                            app:cardCornerRadius="@dimen/radius_lg"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:drawablePadding="@dimen/space_8"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingHorizontal="@dimen/space_8"
                                android:paddingVertical="16dp"
                                android:text="@string/dispatcher"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                app:drawableStartCompat="@drawable/baseline_phone_iphone_24"
                                app:drawableTint="@color/white" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Bordered (1dp, NO elevation/shadow) so the swiper reads as a defined pill
                         against the map — replaces the earlier shadow. -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/white_black"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gray_middle_black_middle"
                        app:strokeWidth="1dp">

                        <com.ncorti.slidetoact.SlideToActView
                            android:id="@+id/sbStartJob"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            app:animation_duration="250"
                            app:area_margin="4dp"
                            app:inner_color="@color/app_color"
                            app:outer_color="@color/white_black"
                            app:slider_height="55dp"
                            app:slider_locked="false"
                            app:text="@string/start_job"
                            app:text_color="@color/app_color"
                            app:text_size="16sp"
                            app:text_style="bold" />

                        <!-- Connecting section: replaces the slider while going online, so the
                             swipe knob is hidden and the driver only waits (no re-swipe). -->
                        <LinearLayout
                            android:id="@+id/llConnecting"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ProgressBar
                                android:id="@+id/pbConnecting"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:indeterminateTint="@color/app_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_10"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/connecting"
                                android:textColor="@color/app_color"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

            </LinearLayout>

        </FrameLayout>

        <include
            android:id="@+id/includeDialog"
            layout="@layout/dialog_bsh_order_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Branded loading screen shown over the map while its GL surface builds (black until
         the first frame). It reuses the launch splash image, so on a fresh build — cold
         start AND the theme/locale activity recreate — the map area shows the splash instead
         of a dark/near-black surface: never reads as a "black screen", in light OR dark mode,
         and makes cold start seamless (splash → map). Visible on a fresh inflate; MapFragment
         fades it out shortly after build. Cached re-entry keeps it hidden. -->
    <FrameLayout
        android:id="@+id/flMapLoadingMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_splash" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="72dp"
            android:indeterminateTint="@color/white" />

    </FrameLayout>

</FrameLayout>