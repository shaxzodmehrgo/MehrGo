<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_12"
    app:cardBackgroundColor="@color/white_black"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="invisible">

            <!-- Top row: distance to client (big) + payment chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tv_order_id"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/icon_distance"
                        app:tint="@color/app_color" />

                    <TextView
                        android:id="@+id/tvDistanceClient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="1,6 km"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textColor="@color/black_white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lang_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_8">

                    <ImageView
                        android:id="@+id/ivPaymentType"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="@dimen/space_6"
                        app:tint="@color/app_color" />

                    <TextView
                        android:id="@+id/tvPaymentType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.App.Section"
                        android:textColor="@color/black_white" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_16"
                android:background="@color/gray_middle_black_middle" />

            <!-- Route flow: pickup → distance → destination -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="2dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/baseline_location_on_24"
                        app:tint="@color/green" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginVertical="4dp"
                        android:layout_weight="1"
                        android:background="@color/gray_middle_black_middle"
                        android:minHeight="20dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/baseline_location_on_24"
                        app:tint="@color/red" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Ohunboboyev massiv"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/black_white" />

                    <!-- Trip-distance removed from order details per request (hidden; still bound). -->
                    <TextView
                        android:id="@+id/tvDistanceTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/gray_full"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAddressFinish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/not_showed"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/black_white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Price block: total is the hero, surge sits underneath when present -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_lang_option"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_14">

                <TextView
                    android:id="@+id/tvSummaTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summa"
                    android:textAppearance="@style/TextAppearance.App.Section"
                    android:textColor="@color/gray_full" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="~25 000 So'm"
                    android:textColor="@color/app_color"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAddPrice"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/baseline_arrow_upward_24"
                        app:tint="@color/green" />

                    <TextView
                        android:id="@+id/tvAddPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="0 so'm"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/green" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCommission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="1000 so'm kommissiya"
                    android:textAppearance="@style/TextAppearance.App.Micro"
                    android:textColor="@color/gray_full"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Optional: order info + services -->
            <LinearLayout
                android:id="@+id/llInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvInfoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/description"
                    android:textAppearance="@style/TextAppearance.App.Section"
                    android:textColor="@color/gray_full" />

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Example desc"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/black_white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvServicesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/services"
                    android:textAppearance="@style/TextAppearance.App.Section"
                    android:textColor="@color/gray_full" />

                <TextView
                    android:id="@+id/tvServices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Service"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/black_white" />
            </LinearLayout>

            <!-- Actions: accept (with countdown) + skip -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_20">

                <ProgressBar
                    android:id="@+id/pbTimer"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/background_progress_bar"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/curved_progress_view" />

                <TextView
                    android:id="@+id/tvAccept"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Qabul qilish  02:29"
                    android:textColor="@color/white"
                    android:textSize="17sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSkip"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/skip"
                android:textColor="@color/black_white"
                android:textSize="17sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="48dp"
            android:visibility="visible" />
    </FrameLayout>

</androidx.cardview.widget.CardView>
