<?xml version="1.0" encoding="utf-8"?><!--
  Live private-offer overlay (AutoOfferService) shown over other apps.
  Full Android twin of the iOS OrderOfferSheet: header chip + title, a
  scrollable detail stack (colour-dot route with pickup ETA, passenger card,
  meta card with tariff chip + comment + bonus/commission badges, soft price
  block with the trip distance) and a pinned Accept (countdown bar) + Skip.

  Plain CardView (no MaterialCardView) — the service/overlay context has no
  Material Components theme. The 1.5dp inset over the border-colour card
  background renders a crisp border that lifts the card off the app behind it.
  ALL view IDs are preserved / consumed by AutoOfferService.setData().
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/gray_middle_black_middle"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1.5dp"
        android:background="@drawable/bg_overlay_card_fill">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="invisible">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_chip_round">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ph_user_circle"
                        android:tint="@color/app_color" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/individual_order"
                        android:textAppearance="@style/TextAppearance.App.Headline"
                        android:textColor="@color/app_color"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/offer_subtitle"
                        android:textAppearance="@style/TextAppearance.App.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Detail — single page; wrap_content so the card fits it all (the ScrollView only
                 ever scrolls as a fallback if the content would exceed the screen). -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <!-- Route -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_section_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Pickup -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/shape_dot"
                                android:backgroundTint="@color/green" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvAddress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="@string/not_showed"
                                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                    android:textColor="@color/black_white" />

                                <TextView
                                    android:id="@+id/tvAddressSub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.App.Caption"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:scaleX="-1"
                                        android:src="@drawable/ph_navigation_arrow"
                                        android:tint="@color/app_color" />

                                    <TextView
                                        android:id="@+id/tvDistanceClient"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="@string/not_defined"
                                        android:textColor="@color/app_color"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Intermediate stops (everything between pickup and dropoff) -->
                        <LinearLayout
                            android:id="@+id/llMiddlePoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />

                        <!-- Dropoff -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/shape_dot"
                                android:backgroundTint="@color/red" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvAddressFinish"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="@string/not_showed"
                                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                    android:textColor="@color/black_white" />

                                <TextView
                                    android:id="@+id/tvAddressFinishSub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.App.Caption"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Passenger -->
                    <LinearLayout
                        android:id="@+id/cardPassenger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_section_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ph_user_circle"
                            android:tint="@color/app_color" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/passenger"
                                android:textAppearance="@style/TextAppearance.App.Micro" />

                            <TextView
                                android:id="@+id/tvPassengerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.App.Label"
                                android:textColor="@color/black_white" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBonusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_orange_soft"
                            android:drawableStart="@drawable/ph_gift"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/app_color"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/app_color"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Meta: payment + tariff + comment + badges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_section_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivPaymentType"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:tint="@color/green" />

                            <TextView
                                android:id="@+id/tvPaymentType"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/black_white"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvTariff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_gray"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Badges -->
                        <LinearLayout
                            android:id="@+id/llBadges"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvBadgeBonus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_orange_soft"
                                android:drawableStart="@drawable/baseline_card_giftcard_24"
                                android:drawablePadding="4dp"
                                android:drawableTint="@color/app_color"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="@string/bonus_applied"
                                android:textColor="@color/app_color"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Client's comment — its OWN section card, lifted out of the meta card so a
                         long note doesn't crowd the payment row. Matches the sibling cards'
                         14dp padding / 10dp top margin (this file hardcodes those, it does not
                         use the space_* tokens). -->
                    <LinearLayout
                        android:id="@+id/llInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_section_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/description"
                            android:textAppearance="@style/TextAppearance.App.Section" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <!-- android:tint, NOT app:tint. This layout is inflated by a Service
                                 through a bare ContextThemeWrapper, so the ImageView is a raw
                                 framework one and app:tint is silently dropped — that is why this
                                 icon has been rendering black. The icons that already look right
                                 in this file (ivPaymentType, the ETA arrow) all use android:tint. -->
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ph_chat_text"
                                android:tint="@color/app_color" />

                            <TextView
                                android:id="@+id/tvInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:textAppearance="@style/TextAppearance.App.Body"
                                android:textColor="@color/black_white" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Services -->
                    <LinearLayout
                        android:id="@+id/llServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_section_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvServicesTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/services"
                            android:textAppearance="@style/TextAppearance.App.Section" />

                        <!-- Chips instead of the old comma-joined TextView, matching the in-app
                             offer sheet (dialog_bsh_order_offer.xml) and the profile screen: one
                             adapter_chip TextView per service, flowed by a ChipGroup so long
                             names wrap instead of clipping. Material widgets are safe here —
                             AutoOfferService.themedContext() wraps in Theme.TeamworkTaxi, whose
                             parent IS a MaterialComponents theme (the file header comment claiming
                             otherwise is stale). -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupServices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clickable="false"
                            app:chipSpacingHorizontal="@dimen/space_6"
                            app:chipSpacingVertical="@dimen/space_6" />
                    </LinearLayout>

                    <!-- Price + trip distance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_offer_price"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSummaTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/price"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvTotalPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="0"
                                    android:textColor="@color/app_color"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPriceSum"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginBottom="3dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/app_color"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivAddPrice"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="3dp"
                                    android:src="@drawable/ph_arrow_up"
                                    android:tint="@color/green"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvAddPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textAppearance="@style/TextAppearance.App.Caption"
                                    android:textColor="@color/green"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llOfferDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/client_distance"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/tvDistanceTrack"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/black_white"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Pinned actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <!-- Accept (countdown bar) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp">

                    <ProgressBar
                        android:id="@+id/pbTimer"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/background_progress_bar"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/curved_progress_view" />

                    <!-- Icon + label as a centred ROW, not a compound drawable. A drawableStart on
                         a match_parent TextView is laid out against the VIEW's start edge, not next
                         to the text, so the glyph floated alone at the far left while the label sat
                         in the middle. The click target stays the full-width container (llAccept),
                         and tvAccept keeps its id because the countdown rewrites its text. -->
                    <LinearLayout
                        android:id="@+id/llAccept"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ph_check_circle"
                            android:tint="@color/white" />

                        <TextView
                            android:id="@+id/tvAccept"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/accept"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Skip (neutral) — same centred-row treatment as Accept above. -->
                <LinearLayout
                    android:id="@+id/llSkip"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_neutral_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ph_x"
                        android:tint="@color/gray_full" />

                    <TextView
                        android:id="@+id/tvSkip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/skip"
                        android:textColor="@color/gray_full"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="32dp"
            android:visibility="visible" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
