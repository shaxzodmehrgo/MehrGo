<?xml version="1.0" encoding="utf-8"?><!-- Pickup marker for the trip mini-map: green disc with a white ring. Sized so the
     Yandex ImageProvider has intrinsic bounds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/green" />
    <stroke
        android:width="2.5dp"
        android:color="@color/white" />
    <size
        android:width="18dp"
        android:height="18dp" />
</shape>
