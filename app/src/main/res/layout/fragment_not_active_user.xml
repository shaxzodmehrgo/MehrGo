<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light_black_light"
    android:orientation="vertical"
    tools:context=".presentation.main.ui.not_active_user.NotActiveUserFragment">

    <!-- No toolbar chrome here on purpose: this screen has no title and no back action, so the
         white bar + divider was an empty strip that just walled off the page (boss: "unfriendly").
         The row is kept — transparent, sized to the chip — for TWO reasons: it still carries the
         id `clToolbar`, which is what MainActivity's central callback keys off to apply the
         status-bar inset (drop the id and the chip lands under the clock), and it keeps the chip
         right-aligned. Height is wrap_content so the row is only as tall as the chip + padding. -->
    <LinearLayout
        android:id="@+id/clToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_12"
        android:paddingVertical="@dimen/space_8">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Logout: a soft-red rounded chip (task 12) instead of a bare floating icon, matching
             the app's iOS-style soft-accent icon chips. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvExit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_button"
            app:cardBackgroundColor="@color/red_soft"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivExit"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/baseline_exit_to_app_24"
                app:tint="@color/red" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/llUserNotActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/space_24"
                android:layout_marginBottom="140dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_8"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/shape_dot"
                        android:backgroundTint="@color/app_color_soft" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_history_24"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:gravity="center"
                    android:text="@string/your_profile_under_review"
                    android:textAppearance="@style/TextAppearance.App.Display"
                    android:textColor="@color/black_white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/under_review_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/gray_full" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvDispatcherCall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_button"
                    app:cardBackgroundColor="@color/gray_middle_black_middle"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_call"
                        android:drawablePadding="@dimen/space_8"
                        android:drawableTint="@color/black_white"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/space_20"
                        android:paddingVertical="@dimen/space_12"
                        android:text="@string/communicate_support"
                        android:textColor="@color/black_white"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvOperatorNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/black_white"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="+998 90 123 45 67" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvRefresh"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="@dimen/space_16"
                android:text="@string/update" />

        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>