<?xml version="1.0" encoding="utf-8"?><!-- Filled-area gradient under the earnings line chart: amber ~35% → ~2% (top→bottom),
     matching iOS EarningsLineChart's LinearGradientFill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#05F59E0B"
        android:startColor="#59F59E0B"
        android:type="linear" />
</shape>
