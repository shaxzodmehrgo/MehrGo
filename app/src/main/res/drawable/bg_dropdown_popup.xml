<?xml version="1.0" encoding="utf-8"?><!-- Rounded, themed background for the dropdown (ExposedDropdownMenu) popups.
     The vertical padding keeps the first/last item's highlight inside the rounded
     corners so the selection never spills into a square edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white_black" />
    <corners android:radius="@dimen/radius_md" />
    <stroke
        android:width="1dp"
        android:color="@color/gray_middle_black_middle" />
    <padding
        android:bottom="@dimen/space_8"
        android:top="@dimen/space_8" />
</shape>
