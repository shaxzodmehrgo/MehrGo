<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.activity.splash.FirstActivity">

    <ImageView
        android:id="@+id/ivSplashScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_splash"
        android:visibility="visible" />

    <!-- The status bar (white) and navigation bar (brand green) are colored by
         Theme.TeamworkTaxi.Splash; no scrim bands needed here. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clUpdate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/llBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.22">

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="320dp">

                <View
                    android:layout_width="320dp"
                    android:layout_height="320dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_update_hero_outer" />

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_update_hero_inner" />

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/update_icon_white" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvUpdateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_update_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/update_badge"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:paddingHorizontal="32dp"
                android:text="@string/update_title"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.85"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="36dp"
                android:text="@string/update_text"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:text="@string/update"
                    android:textColor="@color/text_color"
                    android:textSize="16sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSkip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/skip"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Android 15+ edge-to-edge: the splash theme's white status-bar / brand-teal nav-bar
         colors are ignored under enforcement (bars are always transparent), so these strips
         paint the same bands over the full-bleed content — on the splash AND the update
         screen, matching the pre-15 look. Heights are set from the window insets in
         FirstActivity on SDK 35+ only; below 35 they stay gone and the theme colors the
         real bars. -->
    <View
        android:id="@+id/vSplashStatusBarBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/white"
        android:visibility="gone" />

    <View
        android:id="@+id/vSplashNavBarBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@color/brand_teal"
        android:visibility="gone" />

</FrameLayout>
