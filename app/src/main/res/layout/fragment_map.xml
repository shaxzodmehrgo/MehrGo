<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.maps.yandex_map.MapFragment">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/app_color"
        android:visibility="gone" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.yandex.mapkit.mapview.MapView
                android:id="@+id/mapKit"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Soft red wash shown over the map when offline/inactive (iOS parity).
                 Visibility is driven together with tvNoConnection in MapFragment. -->
            <View
                android:id="@+id/vOfflineWash"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_offline_wash"
                android:visibility="gone" />

            <!-- Profile (top-right) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSettings"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/app_color"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="2dp"
                app:strokeColor="@color/gray_middle_black_middle"
                app:strokeWidth="2dp">

                <!-- Placeholder glyph on the brand fill: holds the button until the driver's
                     photo decodes, so the control is never a blank disc. -->
                <ImageView
                    android:id="@+id/ivProfilePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:src="@drawable/icon_user"
                    app:tint="@color/white" />

                <!-- Full-bleed photo, revealed only on a successful load. INVISIBLE, not gone:
                     Glide never starts a load into an unmeasured view. -->
                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="invisible"
                    tools:visibility="visible" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Right rail (orders / bell / geo / + / −) — centred, nudged up like iOS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginBottom="56dp"
                android:gravity="end"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:backgroundTint="@color/white_black"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gray_middle_black_middle"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:src="@drawable/baseline_format_list_bulleted_24"
                            app:tint="@color/black_white" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvOrderCount"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:backgroundTint="@color/red"
                        android:visibility="gone"
                        app:cardCornerRadius="@dimen/radius_pill"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/white_black"
                        app:strokeWidth="1.5dp">

                        <TextView
                            android:id="@+id/tvOrderCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="11sp" />

                    </com.google.android.material.card.MaterialCardView>


                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/white_black"
                    app:cardCornerRadius="@dimen/radius_sm"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/gray_middle_black_middle"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_margin="10dp"
                        android:src="@drawable/ic_notifications_black_24dp"
                        app:tint="@color/black_white" />

                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    tools:ignore="RtlSymmetry">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvMyCurrentLocationEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/white_black"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gray_middle_black_middle"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_margin="10dp"
                            android:src="@drawable/outline_near_me_24"
                            app:tint="@color/app_color" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvMyCurrentLocationDisabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/white_black"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gray_middle_black_middle"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_margin="10dp"
                            android:src="@drawable/outline_near_me_disabled_24"
                            app:tint="@color/black_white" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvPlus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/white_black"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gray_middle_black_middle"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_margin="10dp"
                            android:src="@drawable/baseline_add_24"
                            app:tint="@color/black_white" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvMinus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/white_black"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gray_middle_black_middle"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_margin="10dp"
                            android:src="@drawable/baseline_remove_24"
                            app:tint="@color/black_white" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </LinearLayout>

            <!-- Centered today-earnings capsule (matches the iOS earningsPill) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTodayEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/white_black"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="0dp"
                app:strokeColor="@color/gray_middle_black_middle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_20"
                    android:paddingVertical="@dimen/space_8">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTodayPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.App.Price" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/sum"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/baseline_check_circle_24"
                            app:tint="@color/app_color" />

                        <TextView
                            android:id="@+id/tvTodayCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="0"
                            android:textColor="@color/black_white"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Optional / under-review verification chip — shown at the connection-badge
                 slot once the driver is online (white bg, amber icon + text). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvVerificationChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginHorizontal="@dimen/space_16"
                android:layout_marginTop="92dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white_black"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="2dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_10">

                    <ImageView
                        android:id="@+id/ivChipIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ph_warning"
                        app:tint="@color/app_color" />

                    <TextView
                        android:id="@+id/tvChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/verification_chip_suggestion"
                        android:textColor="@color/app_color"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSpeed"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white_black"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="0dp"
                app:strokeColor="@color/gray_middle_black_middle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white_black"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/black_white"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textColor="@color/gray_full"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

