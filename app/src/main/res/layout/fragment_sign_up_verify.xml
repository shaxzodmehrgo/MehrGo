<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.auth.ui.sign_up_verify.SignUpVerifyFragment">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="?attr/actionBarSize"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle"
                android:padding="10dp"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/flAsk"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="invisible">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_circle_24"
                    app:tint="@color/app_color_soft" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_question_mark_24"
                    app:tint="@color/app_color" />

            </FrameLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/gray_middle_black_middle" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_permission_icon">

                    <!-- Channel glyph: SMS bubble by default; swapped to the colored Telegram
                         plane (tint cleared) when the code went via Telegram. -->
                    <ImageView
                        android:id="@+id/ivChannelIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sms_24"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:text="@string/verification_code_label"
                    android:textAppearance="@style/TextAppearance.App.Display" />

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="@dimen/space_16"
                    android:text="@string/verification_code_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Caption" />

                <FrameLayout
                    android:id="@+id/otpContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:clickable="true"
                    android:focusable="true">

                    <EditText
                        android:id="@+id/etVerifyCode"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:alpha="0"
                        android:inputType="number"
                        android:maxLength="4" />

                    <LinearLayout
                        android:id="@+id/otpRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/otpCell0"
                            android:layout_width="58dp"
                            android:layout_height="60dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_otp_empty"
                            android:gravity="center"
                            android:textColor="@color/app_color"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/otpCell1"
                            android:layout_width="58dp"
                            android:layout_height="60dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_otp_empty"
                            android:gravity="center"
                            android:textColor="@color/app_color"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/otpCell2"
                            android:layout_width="58dp"
                            android:layout_height="60dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_otp_empty"
                            android:gravity="center"
                            android:textColor="@color/app_color"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/otpCell3"
                            android:layout_width="58dp"
                            android:layout_height="60dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_otp_empty"
                            android:gravity="center"
                            android:textColor="@color/app_color"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Resend sits ABOVE the primary CTA (boss request): while the cooldown runs
                     it is the only thing the driver can act on, so it must not be buried under
                     the button they cannot use yet. -->
                <TextView
                    android:id="@+id/tvGetNewCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_20"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/ripple_rounded_8dp"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_8"
                    android:text="@string/get_new_verify_code"
                    android:textColor="@color/app_color"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <TextView
                        android:id="@+id/tvSubmit"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/submit" />

                    <ProgressBar
                        android:id="@+id/pbSubmit"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Only when the code went to Telegram: jump to the bot to read/link.
                     Styled as a real secondary button so it can't be missed. -->
                <TextView
                    android:id="@+id/tvOpenBot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_button_soft"
                    android:clickable="true"
                    android:drawablePadding="@dimen/space_8"
                    android:drawableTint="@color/app_color"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/ripple_intro_skip"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_24"
                    android:paddingVertical="@dimen/space_12"
                    android:text="@string/open_telegram_bot"
                    android:textColor="@color/app_color"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/icon_telegram" />

                <!-- Offer the OTHER delivery channel; shown only once the resend cooldown
                     ends (a switch also re-requests a rate-limited code). Icon+label follow
                     the current channel in code. -->
                <TextView
                    android:id="@+id/tvSwitchChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_button_soft"
                    android:clickable="true"
                    android:drawablePadding="@dimen/space_8"
                    android:drawableTint="@color/app_color"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/ripple_intro_skip"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_24"
                    android:paddingVertical="@dimen/space_12"
                    android:text="@string/receive_via_telegram"
                    android:textColor="@color/app_color"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/icon_telegram" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/app_color"
        android:visibility="gone" />

</FrameLayout>
