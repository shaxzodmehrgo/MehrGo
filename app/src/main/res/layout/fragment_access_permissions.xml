<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_black"
    android:orientation="vertical"
    tools:context=".presentation.main.ui.permissions.AccessPermissionsFragment">

    <TextView
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_16"
        android:text="@string/permissions"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="@color/black_white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingBottom="20dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_permission_icon">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_permissions_header"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:alpha="0.6"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/access_permissions_subtitle"
                    android:textColor="@color/black_white"
                    android:textSize="13sp" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clOtherPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_permission_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_16dp"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/iconBgOther"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_permission_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_settings_24"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llOtherPermissions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivOtherPermissionsGranted"
                    app:layout_constraintStart_toEndOf="@+id/iconBgOther"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/other_permissions"
                        android:textColor="@color/black_white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/access_permissions_message_others"
                        android:textColor="@color/black_white"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivOtherPermissionsGranted"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_cancel_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clBackgroundLocationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_permission_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_16dp"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/iconBgLocation"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_permission_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_location_on_24"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llLocationPermission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivBackgroundLocationPermissionGranted"
                    app:layout_constraintStart_toEndOf="@+id/iconBgLocation"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/location"
                        android:textColor="@color/black_white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/access_permission_message_location"
                        android:textColor="@color/black_white"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivBackgroundLocationPermissionGranted"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_cancel_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/vBackgroundLocation"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clOpenOtherApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_permission_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_16dp"
                android:padding="16dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/iconBgOverlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_permission_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pip_24"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llOpenOtherApps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivOpenOtherApps"
                    app:layout_constraintStart_toEndOf="@+id/iconBgOverlay"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/open_on_other_apps"
                        android:textColor="@color/black_white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/open_on_other_apps_message"
                        android:textColor="@color/black_white"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivOpenOtherApps"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_cancel_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/vLineOpenOtherApps"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_permission_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_16dp"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/iconBgBattery"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_permission_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery_24"
                        app:tint="@color/app_color" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llBatteryOptimization"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivBatteryOptimization"
                    app:layout_constraintStart_toEndOf="@+id/iconBgBattery"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/battery_optimisation"
                        android:textColor="@color/black_white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/battery_optimisation_message"
                        android:textColor="@color/black_white"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivBatteryOptimization"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_cancel_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvSubmit"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/submit" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
