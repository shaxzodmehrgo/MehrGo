<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.main.ui.driver_earnings.DriverEarningsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar"
        android:paddingHorizontal="@dimen/space_8"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/space_8"
                android:src="@drawable/baseline_keyboard_backspace_24"
                app:tint="@color/black_white" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/earnings"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textColor="@color/black_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/mcvBack"
            app:layout_constraintRight_toLeftOf="@id/mcvRefresh"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/space_8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:src="@drawable/baseline_calendar_month_24"
                app:tint="@color/app_color" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_light_black_light">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <!-- ===== Custom date range (shown only for the "Tanlash" period) ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDateRange"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_8">

                        <LinearLayout
                            android:id="@+id/llStartDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/space_12">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/baseline_calendar_month_24"
                                app:tint="@color/app_color" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:layout_weight="1"
                                android:text="@string/earnings_start"
                                android:textColor="@color/gray_full"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvStartDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/black_white"
                                android:textSize="14sp"
                                tools:text="01.06.2026" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/space_12"
                            android:background="@color/gray_middle_black_middle" />

                        <LinearLayout
                            android:id="@+id/llEndDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/space_12">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/baseline_calendar_month_24"
                                app:tint="@color/app_color" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:layout_weight="1"
                                android:text="@string/earnings_end"
                                android:textColor="@color/gray_full"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvEndDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/black_white"
                                android:textSize="14sp"
                                tools:text="19.06.2026" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mcvApply"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/space_8"
                            app:cardBackgroundColor="@color/app_color"
                            app:cardCornerRadius="@dimen/radius_lg"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:paddingVertical="@dimen/space_14"
                                android:text="@string/earnings_apply"
                                android:textColor="@color/text_submit_state"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Hero: total + period pill + trips count ===== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/radius_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_balance_gradient"
                        android:orientation="vertical"
                        android:padding="@dimen/space_20">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/llPeriodPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:backgroundTint="#33FFFFFF"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_10"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:src="@drawable/baseline_calendar_month_24"
                                    app:tint="@color/white" />

                                <TextView
                                    android:id="@+id/tvPeriodPill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_4"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    tools:text="Oy" />

                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:backgroundTint="#33FFFFFF"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_10"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/baseline_directions_car_24"
                                    app:tint="@color/white" />

                                <TextView
                                    android:id="@+id/tvTripsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_4"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    tools:text="44" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_10"
                            android:alpha="0.85"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/total_earned"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:baselineAligned="true"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEarned"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                tools:text="545 272" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginBottom="3dp"
                                android:alpha="0.85"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/sum"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ===== KPI grid: distance + bonus ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_6"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardBackgroundColor="@color/blue_soft"
                                app:cardCornerRadius="@dimen/radius_sm"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_straighten_24"
                                    app:tint="@color/blue_middle" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_10"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/black_white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="28.70 km" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/driver_earnings_distance"
                                android:textColor="@color/gray_full"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardBackgroundColor="@color/green_soft"
                                app:cardCornerRadius="@dimen/radius_sm"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_card_giftcard_24"
                                    app:tint="@color/green" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvBonus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_10"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/black_white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="200 000 so'm" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/bonus"
                                android:textColor="@color/gray_full"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ===== Daily earnings line chart ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcvChart"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <!-- Title + hint + best-day badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/driver_earnings_graph_title"
                                    android:textColor="@color/black_white"
                                    android:textSize="15sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:text="@string/by_day_hint"
                                    android:textColor="@color/gray_full"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llBestDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:backgroundTint="@color/green_soft"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_8"
                                android:paddingVertical="4dp"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:rotation="45"
                                    android:src="@drawable/baseline_arrow_upward_24"
                                    app:tint="@color/green" />

                                <TextView
                                    android:id="@+id/tvBestDay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_4"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/green"
                                    android:textSize="12sp"
                                    tools:text="88 869" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Period navigation -->
                        <LinearLayout
                            android:id="@+id/llMonthNav"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/mcvPrevMonth"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:rippleColor="@color/gray_middle_black_middle">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:rotation="180"
                                    android:src="@drawable/baseline_arrow_forward_ios_24"
                                    app:tint="@color/black_white" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvMonthLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:minWidth="150dp"
                                android:paddingHorizontal="12dp"
                                android:textAlignment="center"
                                android:textColor="@color/black_white"
                                android:textSize="15sp"
                                tools:text="Iyun 2026" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/mcvNextMonth"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:rippleColor="@color/gray_middle_black_middle">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_arrow_forward_ios_24"
                                    app:tint="@color/black_white" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="@dimen/space_8" />

                        <TextView
                            android:id="@+id/tvGraphEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:drawableTop="@drawable/baseline_directions_car_24"
                            android:drawablePadding="@dimen/space_12"
                            android:drawableTint="@color/gray"
                            android:gravity="center"
                            android:text="@string/there_is_no_orders"
                            android:textAppearance="@style/TextAppearance.App.Headline"
                            android:textColor="@color/gray_full"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
